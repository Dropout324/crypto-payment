# =============================================================================
# Crypto Payment Gateway - environment template
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Every secret below must be unique per environment and rotated on a schedule.
#
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# Comma-separated. Requests from other origins are rejected outright.
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PORT=4000
API_HOST=0.0.0.0
# Public base URL of the API, used to build hosted payment page links.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
# Read by apps/web at build time (Next.js inlines NEXT_PUBLIC_* vars into the
# client bundle) - the browser calls the API directly at this URL rather than
# through a proxy; see apps/web/src/lib/config.ts.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change_me_in_every_environment
POSTGRES_DB=gateway
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gateway:change_me_in_every_environment@localhost:5432/gateway?schema=public&connection_limit=20&pool_timeout=10
# Every integration suite resolves its database from this, never DATABASE_URL
# (ADR 0020) - must contain "test" in the database name, or resolution refuses
# to run. `scripts/dev-postgres.ps1 init` provisions gateway_test alongside gateway.
TEST_DATABASE_URL=postgresql://gateway:change_me_in_every_environment@localhost:5432/gateway_test?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Separate logical databases keep cache eviction away from queue state.
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# --- Authentication ----------------------------------------------------------
# 48+ random bytes. Rotating these invalidates all sessions.
JWT_ACCESS_SECRET=replace_with_48_random_bytes
JWT_REFRESH_SECRET=replace_with_a_different_48_random_bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=crypto-payment-gateway
JWT_AUDIENCE=gateway-dashboard

# Argon2id parameters. Raise memory/time as hardware allows; never lower them.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Application-layer encryption --------------------------------------------
# AES-256-GCM key for encrypting webhook secrets and TOTP seeds at rest.
# 32 bytes, base64. In production this comes from KMS, not from an env var.
ENCRYPTION_KEY=replace_with_32_random_bytes_base64
# Key id recorded alongside ciphertext so keys can be rotated without downtime.
ENCRYPTION_KEY_ID=local-dev-1

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INVOICE_CREATE_PER_MINUTE=60
RATE_LIMIT_TRUST_PROXY=false

# --- Webhooks ----------------------------------------------------------------
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
# Merchant must reject signatures older than this. Also enforced on our side.
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# SSRF guard: refuse to deliver to private/link-local ranges. Keep true.
WEBHOOK_BLOCK_PRIVATE_NETWORKS=true
# An endpoint auto-disables after this many consecutive delivery failures,
# across all its events - not just one event's retry chain.
WEBHOOK_DISABLE_AFTER_CONSECUTIVE_FAILURES=50

# --- Worker (apps/worker: webhook dispatch + invoice expiry sweep) ----------
WORKER_WEBHOOK_POLL_INTERVAL_MS=5000
WORKER_WEBHOOK_BATCH_SIZE=100
WORKER_EXPIRY_SWEEP_INTERVAL_MS=30000
WORKER_EXPIRY_SWEEP_BATCH_SIZE=200

# --- Invoices ----------------------------------------------------------------
INVOICE_DEFAULT_EXPIRY_SECONDS=900
INVOICE_MAX_EXPIRY_SECONDS=86400

# --- Exchange rates ----------------------------------------------------------
# Priority order; the next provider is tried when one times out.
EXCHANGE_RATE_PROVIDERS=coingecko,binance
EXCHANGE_RATE_TIMEOUT_MS=3000
# Refuse to price an invoice with a quote older than this.
EXCHANGE_RATE_MAX_AGE_SECONDS=120
EXCHANGE_RATE_CACHE_TTL_SECONDS=30
COINGECKO_API_KEY=
BINANCE_API_BASE=https://api.binance.com

# --- Blockchain RPC ----------------------------------------------------------
# Leave a network's URL empty to disable its monitor. In production, every
# mainnet network (ETHEREUM/POLYGON/BSC) must also set its *_FALLBACK_URL -
# validateProductionConfig (apps/blockchain-monitor/src/config.ts) refuses to
# boot otherwise, since a single RPC provider is a single point of failure
# for confirmation processing on that network.
ETHEREUM_RPC_URL=
ETHEREUM_RPC_WS_URL=
ETHEREUM_RPC_FALLBACK_URL=
POLYGON_RPC_URL=
POLYGON_RPC_WS_URL=
POLYGON_RPC_FALLBACK_URL=
BSC_RPC_URL=
BSC_RPC_WS_URL=
BSC_RPC_FALLBACK_URL=
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# Testnets, for development.
ETHEREUM_SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=
BSC_TESTNET_RPC_URL=
BITCOIN_TESTNET_RPC_URL=
BITCOIN_TESTNET_RPC_USER=
BITCOIN_TESTNET_RPC_PASSWORD=
# Local regtest node (docker compose --profile bitcoin up bitcoind-regtest),
# for development and the Phase 13 test suite - never a real network.
# http://127.0.0.1:18443
BITCOIN_REGTEST_RPC_URL=
BITCOIN_REGTEST_RPC_USER=gateway
BITCOIN_REGTEST_RPC_PASSWORD=gateway_dev_password

# --- Blockchain monitor ------------------------------------------------------
MONITOR_POLL_INTERVAL_MS=5000
MONITOR_BLOCK_BATCH_SIZE=50
# How long a worker's lease on a network lasts before another may take over.
MONITOR_LEASE_SECONDS=60
# Alert when the monitor falls this far behind the chain tip.
MONITOR_MAX_LAG_BLOCKS=50

# --- Signing service (custodial mode only, Phase 12 - ADR 0026) -------------
# The API never holds private keys. SIGNING_BACKEND selects which
# @gateway/signing SigningBackend apps/api wires up: "disabled" (default,
# always throws - no signature can ever be produced) or
# "emulated-hsm-staging" (a software HSM emulation for demonstrating the
# signing architecture - never a real KMS/HSM). validateProductionConfig
# refuses anything but "disabled" in production; Mode A (custodial signing)
# is not live regardless of this setting.
SIGNING_BACKEND=disabled
# Comma-separated lowercased destination addresses the signing policy allows.
SIGNING_ALLOWED_DESTINATIONS=
# Smallest unit (matches the asset's own decimals - e.g. USDT's 6).
SIGNING_MAX_AMOUNT_PER_TX=0
SIGNING_MAX_AMOUNT_PER_WINDOW=0
SIGNING_WINDOW_SECONDS=86400
SIGNING_REQUIRED_APPROVALS=2
# The following are unused placeholders for a future real KMS/HSM
# integration - no such account exists in this project yet (ADR 0013, ADR 0026).
SIGNING_SERVICE_URL=
SIGNING_SERVICE_TOKEN=
KMS_PROVIDER=none
KMS_KEY_ID=

# --- Compliance --------------------------------------------------------------
COMPLIANCE_PROVIDER=none
COMPLIANCE_API_KEY=
# Deposits at or above this value (in USD minor units) trigger enhanced review.
COMPLIANCE_REVIEW_THRESHOLD_USD_CENTS=1000000
SANCTIONS_SCREENING_ENABLED=false

# --- Observability (ADR 0019) -------------------------------------------------
# Structured JSON logs (pino) on every service; LOG_LEVEL applies to all four.
# fatal|error|warn|info|debug|trace|silent.
# (LOG_LEVEL is declared above, in --- Runtime ---.)
#
# OTEL_* is reserved for a future distributed-tracing pass - nothing in this
# codebase reads it yet. Structured logs plus /metrics (below) are this
# phase's observability; do not expect a trace collector to receive anything.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=gateway-api
# `/metrics` (Prometheus exposition) is served on its own port on every
# service, deliberately never the public one - see ADR 0019 for why.
METRICS_ENABLED=true
METRICS_PORT=9464
# apps/worker's /health, /ready and /metrics (it has no other HTTP server).
WORKER_HEALTH_PORT=9465
# apps/blockchain-monitor's /health, /ready and /metrics.
MONITOR_HEALTH_PORT=9466
# apps/web's /metrics port (/health stays on the public PORT - see ADR 0019).
WEB_METRICS_PORT=9467
# Upper bound (ms) apps/api and apps/web wait for in-flight requests to drain
# on SIGTERM/SIGINT before forcing the process closed.
SHUTDOWN_TIMEOUT_MS=10000

# --- Enterprise demo (Phase 19, `pnpm demo` - see apps/api/demo/README.md) ---
# A funded Ethereum Sepolia testnet wallet the demo script sends a real (free,
# faucet-funded) test payment from. Never a mainnet key; never real funds.
# Leave empty and run `pnpm demo` once - it generates one and prints faucet
# instructions.
DEMO_WALLET_PRIVATE_KEY=
