// Crypto Payment Gateway - database schema.
//
// Conventions enforced throughout:
//  * Identifiers are prefixed ULIDs generated by the application (@gateway/shared),
//    not database sequences: they are sortable, opaque, and safe to expose.
//  * Every monetary column is NUMERIC(78, 0) holding the asset's SMALLEST UNITS.
//    78 digits covers uint256. There is no floating point anywhere in this schema.
//  * Tables that constitute the financial record (ledger_entries, payment_events,
//    audit_logs, blockchain_transactions) are append-only by policy; corrections
//    are new rows, never UPDATEs. Database-level enforcement lives in the
//    migration's triggers.
//  * Timestamps are timestamptz, always UTC.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Network {
  BITCOIN
  BITCOIN_TESTNET
  ETHEREUM
  ETHEREUM_SEPOLIA
  POLYGON
  POLYGON_AMOY
  BSC
  BSC_TESTNET
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/// Platform-wide role. Merchant-scoped permissions live on MerchantMember.
enum PlatformRole {
  /// Ordinary merchant user, no platform privileges.
  USER
  /// Read-only access to the admin dashboard.
  SUPPORT
  /// Can act on compliance queues.
  COMPLIANCE_OFFICER
  /// Full platform administration.
  ADMIN
}

/// Role a user holds within one merchant account.
enum MerchantRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum MerchantStatus {
  /// Created, cannot transact until KYB completes.
  PENDING_VERIFICATION
  ACTIVE
  /// Temporarily blocked (compliance, billing, abuse).
  SUSPENDED
  CLOSED
}

/// SPEC section 7: which side controls the private keys.
enum WalletMode {
  /// Gateway derives and controls deposit addresses via the signing service.
  CUSTODIAL
  /// Merchant supplies destinations; the gateway only watches the chain.
  MERCHANT_CONTROLLED
}

enum ApiKeyStatus {
  ACTIVE
  /// Superseded during rotation; still valid until graceAt.
  ROTATING
  REVOKED
  EXPIRED
}

enum InvoiceStatus {
  CREATED
  PENDING
  DETECTED
  CONFIRMING
  PAID
  UNDERPAID
  OVERPAID
  EXPIRED
  CANCELLED
  FAILED
  REFUNDED
  COMPLIANCE_REVIEW_REQUIRED
  LATE_PAYMENT_REVIEW
  RECONCILIATION_REQUIRED
}

/// SPEC section 12: what to do when the customer sends too little.
enum UnderpaymentPolicy {
  REJECT
  ACCEPT_PARTIAL
  REQUEST_ADDITIONAL
  MANUAL_REVIEW
}

/// SPEC section 13: what to do when the customer sends too much.
enum OverpaymentPolicy {
  ACCEPT_FULL
  CREDIT_DIFFERENCE
  REFUND_DIFFERENCE
  MANUAL_REVIEW
}

enum AddressStatus {
  /// Derived and held in the pool, not yet handed to an invoice.
  AVAILABLE
  /// Assigned to a live invoice.
  ASSIGNED
  /// Invoice closed; kept for late-payment detection, never reassigned.
  RETIRED
  /// Withdrawn from use (compromise, derivation error, chain issue).
  BLOCKED
}

enum ChainTxStatus {
  /// Seen in the mempool only.
  MEMPOOL
  /// Included in a block.
  MINED
  /// Reached the network's confirmation threshold.
  CONFIRMED
  /// The transaction reverted on-chain (EVM status = 0).
  REVERTED
  /// Its block was reorganised away.
  ORPHANED
  /// Replaced by another transaction (RBF / same-nonce replacement).
  REPLACED
  /// Disappeared from the mempool without being mined.
  DROPPED
}

/// Why a detected transfer was or was not credited to an invoice.
enum TransferMatchStatus {
  /// Matched an open invoice and was credited.
  CREDITED
  /// Matched an invoice, awaiting confirmations.
  PENDING_CONFIRMATION
  /// Arrived after expiry - queued for review, never auto-credited.
  LATE_PAYMENT_REVIEW
  /// The destination is ours but the asset is not allowlisted.
  UNSUPPORTED_ASSET
  /// Below the asset's dust threshold.
  BELOW_MINIMUM
  /// Destination address belongs to us but no invoice claims it.
  UNMATCHED
  /// Held by a compliance rule.
  COMPLIANCE_HOLD
  /// Ignored after a reorg removed it.
  ORPHANED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum SettlementStatus {
  SCHEDULED
  PENDING_APPROVAL
  PROCESSING
  BROADCAST
  COMPLETED
  FAILED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  COMPLIANCE_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  BROADCAST
  COMPLETED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  IN_FLIGHT
  DELIVERED
  FAILED
  /// Retry budget exhausted.
  EXHAUSTED
  /// Endpoint disabled or merchant closed.
  ABANDONED
}

enum ComplianceStatus {
  NOT_REQUIRED
  PENDING
  PASSED
  FLAGGED
  BLOCKED
}

enum ReconciliationStatus {
  RUNNING
  CLEAN
  DISCREPANCIES_FOUND
  FAILED
}

enum DiscrepancyKind {
  MISSING_TRANSACTION
  DUPLICATE_TRANSACTION
  AMOUNT_MISMATCH
  DESTINATION_MISMATCH
  ASSET_MISMATCH
  LEDGER_IMBALANCE
  SETTLEMENT_MISMATCH
  ORPHANED_CREDIT
}

enum DiscrepancySeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================================================================
// IDENTITY & ACCESS
// ============================================================================

model User {
  id           String       @id
  email        String       @unique
  /// Argon2id hash. The plaintext password never reaches the database.
  passwordHash String       @map("password_hash")
  fullName     String?      @map("full_name")
  platformRole PlatformRole @default(USER) @map("platform_role")
  status       UserStatus   @default(ACTIVE)

  /// TOTP secret, encrypted at the application layer. Never plaintext.
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(6)

  /// Brute-force throttling state.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships MerchantMember[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id String @id

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. The token itself is never stored.
  tokenHash String  @unique @map("token_hash")
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Merchant {
  id          String         @id
  name        String
  /// URL-safe handle used on the hosted payment page.
  slug        String         @unique
  status      MerchantStatus @default(PENDING_VERIFICATION)
  countryCode String?        @map("country_code") @db.Char(2)
  websiteUrl  String?        @map("website_url")
  supportEmail String?       @map("support_email")

  /// Currency the merchant's dashboard and settlements are reported in.
  settlementCurrency String     @default("USD") @map("settlement_currency")
  walletMode         WalletMode @default(MERCHANT_CONTROLLED) @map("wallet_mode")

  // --- Payment handling policy (SPEC sections 12, 13, 28). ---
  underpaymentPolicy UnderpaymentPolicy @default(MANUAL_REVIEW) @map("underpayment_policy")
  overpaymentPolicy  OverpaymentPolicy  @default(MANUAL_REVIEW) @map("overpayment_policy")
  /// Shortfall tolerated before an invoice counts as underpaid, in basis points
  /// of the invoiced amount. 0 means exact-or-more.
  underpaymentToleranceBps Int @default(0) @map("underpayment_tolerance_bps")
  /// Excess tolerated before an invoice counts as overpaid, in basis points.
  overpaymentToleranceBps  Int @default(0) @map("overpayment_tolerance_bps")

  invoiceExpirySeconds Int @default(900) @map("invoice_expiry_seconds")
  /// Gateway fee charged on settled volume.
  feeBps               Int @default(0) @map("fee_bps")

  /// Per-network confirmation overrides, e.g. {"ETHEREUM": 20}. May only RAISE
  /// the asset default, never lower it; enforced in the application layer.
  confirmationOverrides Json @default("{}") @map("confirmation_overrides")

  // --- Compliance (SPEC section 24). ---
  kybStatus         ComplianceStatus @default(PENDING) @map("kyb_status")
  kybCompletedAt    DateTime?        @map("kyb_completed_at") @db.Timestamptz(6)
  riskScore         Int?             @map("risk_score")
  /// ISO country codes the merchant may not serve.
  restrictedCountries String[]       @default([]) @map("restricted_countries")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  members            MerchantMember[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  invoices           Invoice[]
  paymentAddresses   PaymentAddress[]
  payoutDestinations PayoutDestination[]
  wallets            Wallet[]
  settlements        Settlement[]
  refunds            Refund[]
  ledgerAccounts     LedgerAccount[]
  webhookEvents      WebhookEvent[]
  idempotencyKeys    IdempotencyKey[]

  @@index([status])
  @@map("merchants")
}

model MerchantMember {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role MerchantRole @default(VIEWER)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([merchantId, userId])
  @@index([userId])
  @@map("merchant_members")
}

model ApiKey {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  name String

  /// Public, non-secret half shown in dashboards and logs, e.g. "pk_live_7fA2".
  keyPrefix String @unique @map("key_prefix")
  /// Argon2id hash of the secret half. SPEC section 15: the secret is returned
  /// exactly once, at creation, and is unrecoverable afterwards.
  secretHash String @map("secret_hash")
  /// Distinguishes live from test credentials at a glance.
  livemode   Boolean @default(false)

  /// Coarse-grained scopes, e.g. ["invoices:write", "invoices:read"].
  scopes String[] @default([])
  /// Exact-match IP allowlist (ApiKeyGuard does `includes()`, not CIDR range
  /// matching - a "/24" entry here would never match anything). Empty means
  /// "any source".
  ipAllowlist String[] @default([]) @map("ip_allowlist")

  status ApiKeyStatus @default(ACTIVE)

  /// Set when this key replaced another during rotation.
  rotatedFromId String? @map("rotated_from_id")
  /// While rotating, the old key stays valid until this moment.
  graceExpiresAt DateTime? @map("grace_expires_at") @db.Timestamptz(6)

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp String?   @map("last_used_ip") @db.Inet
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([merchantId, status])
  @@map("api_keys")
}

model WebhookEndpoint {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  url String
  /// Event types this endpoint subscribes to. Empty means all.
  eventTypes String[] @default([]) @map("event_types")

  /// HMAC-SHA256 signing secret, encrypted at the application layer.
  secretEncrypted String @map("secret_encrypted")
  /// Non-secret fingerprint so the dashboard can identify the secret in use.
  secretFingerprint String @map("secret_fingerprint")
  /// Previous secret, valid during rotation so in-flight deliveries still verify.
  previousSecretEncrypted String?   @map("previous_secret_encrypted")
  secretRotatedAt         DateTime? @map("secret_rotated_at") @db.Timestamptz(6)

  enabled       Boolean @default(true)
  maxAttempts   Int     @default(8) @map("max_attempts")
  timeoutMs     Int     @default(10000) @map("timeout_ms")

  /// Consecutive failures; the endpoint auto-disables past a threshold.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledReason      String?   @map("disabled_reason")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  deliveries WebhookDelivery[]

  @@index([merchantId, enabled])
  @@map("webhook_endpoints")
}

// ============================================================================
// WALLETS & ADDRESSES (SPEC sections 7, 8)
// ============================================================================

model Wallet {
  id String @id

  merchantId String?   @map("merchant_id")
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  label   String
  network Network
  mode    WalletMode

  /// BIP-32 extended PUBLIC key. Enough to derive deposit addresses; useless
  /// for spending. SPEC section 22: no private key material is ever stored here.
  extendedPublicKey String? @map("extended_public_key")
  /// Opaque handle to the key inside the KMS/HSM. Not a key, a reference.
  signingKeyRef     String? @map("signing_key_ref")
  derivationScheme  String? @map("derivation_scheme")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts WalletAccount[]

  @@index([merchantId, network])
  @@map("wallets")
}

model WalletAccount {
  id String @id

  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  label          String
  /// BIP-44 account path prefix, e.g. "m/84'/0'/0'".
  derivationPath String @map("derivation_path")
  /// Next unused derivation index. Advanced under a row lock so two workers
  /// can never hand out the same address.
  nextIndex      Int    @default(0) @map("next_index")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses PaymentAddress[]

  @@unique([walletId, derivationPath])
  @@map("wallet_accounts")
}

model PaymentAddress {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  walletAccountId String?        @map("wallet_account_id")
  walletAccount   WalletAccount? @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)

  network Network
  /// Stored exactly as the chain presents it, plus a normalised form for matching.
  address           String
  /// Lowercased (EVM) / canonical (Bitcoin) form. All lookups use this column.
  addressNormalized String @map("address_normalized")

  /// Asset this address is expected to receive. Null means any allowlisted
  /// asset on the network (native + tokens share an EVM address).
  assetSymbol String? @map("asset_symbol")

  /// Null for merchant-supplied addresses.
  derivationIndex Int?    @map("derivation_index")
  derivationPath  String? @map("derivation_path")

  status AddressStatus @default(AVAILABLE)

  /// Set while this address serves one invoice. SPEC section 8: an address is
  /// never handed to a second invoice, so this is a one-to-one link.
  invoiceId String?  @unique @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(6)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transfers TokenTransfer[]

  /// The monitor's hot lookup: "is this destination one of ours?"
  @@unique([network, addressNormalized])
  @@index([merchantId, status])
  @@index([status, network])
  @@map("payment_addresses")
}

/// Where a merchant's settled funds are sent. Kept separate from deposit
/// addresses and change-controlled: a payout destination is a security boundary.
model PayoutDestination {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  label             String
  network           Network
  assetSymbol       String  @map("asset_symbol")
  address           String
  addressNormalized String  @map("address_normalized")

  /// Newly added destinations are unusable until the cool-off elapses, so a
  /// stolen session cannot immediately redirect funds.
  activatesAt DateTime  @map("activates_at") @db.Timestamptz(6)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  isActive    Boolean   @default(false) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  settlements Settlement[]

  @@unique([merchantId, network, addressNormalized, assetSymbol])
  @@map("payout_destinations")
}

// ============================================================================
// INVOICES (SPEC section 6)
// ============================================================================

model Invoice {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  /// Merchant's own order identifier. Unique per merchant so a retried
  /// checkout cannot create two invoices for one order.
  orderId           String  @map("order_id")
  externalReference String? @map("external_reference")
  description       String?

  // --- What was charged, in the merchant's currency. ---
  requestedCurrency String  @map("requested_currency")
  requestedDecimals Int     @map("requested_decimals")
  /// Smallest units of requestedCurrency.
  requestedAmount   Decimal @map("requested_amount") @db.Decimal(78, 0)

  // --- What the customer must send, on-chain. ---
  paymentAsset    String  @map("payment_asset")
  paymentDecimals Int     @map("payment_decimals")
  network         Network
  /// Token contract for the payment asset; null for a native coin.
  tokenContract   String? @map("token_contract")
  /// Smallest units of paymentAsset. Immutable after creation.
  cryptoAmount    Decimal @map("crypto_amount") @db.Decimal(78, 0)

  // --- The rate used, frozen at creation (SPEC section 27). ---
  /// Price of one whole paymentAsset in requestedCurrency, scaled by 1e18.
  exchangeRate         Decimal?  @map("exchange_rate") @db.Decimal(78, 0)
  exchangeRateProvider String?   @map("exchange_rate_provider")
  exchangeRateAt       DateTime? @map("exchange_rate_at") @db.Timestamptz(6)

  // --- Settlement policy captured at creation, so later policy changes cannot
  //     retroactively alter how an existing invoice is treated. ---
  underpaymentPolicy       UnderpaymentPolicy @map("underpayment_policy")
  overpaymentPolicy        OverpaymentPolicy  @map("overpayment_policy")
  underpaymentToleranceBps Int                @map("underpayment_tolerance_bps")
  overpaymentToleranceBps  Int                @map("overpayment_tolerance_bps")
  requiredConfirmations    Int                @map("required_confirmations")

  status InvoiceStatus @default(CREATED)

  /// Running total actually received, in paymentAsset smallest units.
  receivedAmount    Decimal @default(0) @map("received_amount") @db.Decimal(78, 0)
  /// Portion of receivedAmount that has reached requiredConfirmations.
  confirmedAmount   Decimal @default(0) @map("confirmed_amount") @db.Decimal(78, 0)
  /// Highest confirmation count among the crediting transactions.
  confirmationCount Int     @default(0) @map("confirmation_count")

  callbackUrl String? @map("callback_url")
  redirectUrl String? @map("redirect_url")
  /// Merchant-supplied key/value pairs echoed back in webhooks.
  metadata    Json    @default("{}")

  complianceStatus ComplianceStatus @default(NOT_REQUIRED) @map("compliance_status")

  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  detectedAt  DateTime? @map("detected_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  expiredAt   DateTime? @map("expired_at") @db.Timestamptz(6)

  /// Optimistic-concurrency guard: every state transition bumps this, so two
  /// workers racing on the same invoice cannot both win.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentAddress   PaymentAddress?
  transfers        TokenTransfer[]
  events           PaymentEvent[]
  webhookEvents    WebhookEvent[]
  refunds          Refund[]
  ledgerTransactions LedgerTransaction[]
  complianceChecks   ComplianceCheck[]

  @@unique([merchantId, orderId])
  @@index([merchantId, status, createdAt])
  @@index([status, expiresAt])
  @@index([network, status])
  @@index([createdAt])
  @@map("invoices")
}

/// Append-only history of everything that happened to an invoice
/// (SPEC section 12 of the deliverables: "every financial operation auditable").
model PaymentEvent {
  id String @id

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  /// e.g. "invoice.created", "transfer.detected", "confirmation.updated".
  type          String
  fromStatus    InvoiceStatus? @map("from_status")
  toStatus      InvoiceStatus? @map("to_status")
  /// Sequential per invoice, gap-free; lets consumers detect missed events.
  sequence      Int
  /// "system", "merchant:<id>", "user:<id>", "monitor:<network>".
  actor         String
  payload       Json           @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([invoiceId, sequence])
  @@index([invoiceId, createdAt])
  @@index([type, createdAt])
  @@map("payment_events")
}

// ============================================================================
// BLOCKCHAIN (SPEC sections 9, 10, 11, 14)
// ============================================================================

/// One transaction as observed on one network. Append-only apart from the
/// mutable confirmation/status fields the monitor maintains.
model BlockchainTransaction {
  id String @id

  network Network
  txHash  String  @map("tx_hash")

  blockNumber BigInt?   @map("block_number")
  blockHash   String?   @map("block_hash")
  blockTime   DateTime? @map("block_time") @db.Timestamptz(6)
  /// Index of the transaction inside its block.
  txIndex     Int?      @map("tx_index")

  status ChainTxStatus @default(MEMPOOL)

  fromAddress String? @map("from_address")
  toAddress   String? @map("to_address")

  /// Network fee paid, in the network's native smallest units.
  feeAmount   Decimal? @map("fee_amount") @db.Decimal(78, 0)
  /// Raw values kept for forensics; never used for crediting decisions.
  rawMetadata Json     @default("{}") @map("raw_metadata")

  confirmations Int @default(0)

  /// Set when this transaction replaced or was replaced by another (RBF).
  replacedByHash String? @map("replaced_by_hash")
  replacesHash   String? @map("replaces_hash")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  minedAt     DateTime? @map("mined_at") @db.Timestamptz(6)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  orphanedAt  DateTime? @map("orphaned_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transfers TokenTransfer[]

  /// SPEC section 14: a hash is unique per network, never globally.
  @@unique([network, txHash])
  @@index([network, status])
  @@index([network, blockNumber])
  @@index([firstSeenAt])
  @@map("blockchain_transactions")
}

/// A single value movement inside a transaction: one ERC-20 Transfer log, or
/// one Bitcoin output. This is the row a payment is credited from.
model TokenTransfer {
  id String @id

  transactionId String                @map("transaction_id")
  transaction   BlockchainTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  network Network
  txHash  String  @map("tx_hash")
  /// EVM: log index. Bitcoin: output (vout) index. Together with the hash and
  /// network this is what makes crediting idempotent (SPEC section 14).
  transferIndex Int @map("transfer_index")

  /// Null for a native-coin transfer.
  tokenContract     String? @map("token_contract")
  assetSymbol       String  @map("asset_symbol")
  assetDecimals     Int     @map("asset_decimals")
  /// Value in the asset's smallest units, exactly as read from the chain.
  amount            Decimal @db.Decimal(78, 0)

  fromAddress           String? @map("from_address")
  toAddress             String  @map("to_address")
  toAddressNormalized   String  @map("to_address_normalized")

  paymentAddressId String?         @map("payment_address_id")
  paymentAddress   PaymentAddress? @relation(fields: [paymentAddressId], references: [id], onDelete: SetNull)

  invoiceId String?  @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  matchStatus TransferMatchStatus @map("match_status")
  /// Human-readable reason when matchStatus is not CREDITED.
  matchReason String?             @map("match_reason")

  confirmations Int      @default(0)
  /// Set once this transfer has been written into the ledger; prevents a
  /// second credit even if the row is reprocessed.
  creditedAt    DateTime? @map("credited_at") @db.Timestamptz(6)

  detectedAt  DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerTransactions LedgerTransaction[]
  complianceChecks   ComplianceCheck[]

  /// THE idempotency constraint. One credit per output, forever.
  @@unique([network, txHash, transferIndex])
  @@index([invoiceId])
  @@index([paymentAddressId])
  @@index([matchStatus, detectedAt])
  @@index([network, toAddressNormalized])
  @@map("token_transfers")
}

/// Per-network scan position for the monitoring workers. A single row per
/// network; workers advance it only after the block is fully processed, so a
/// crash re-processes rather than skips.
model ChainCursor {
  network Network @id

  /// Last block fully processed and committed.
  lastProcessedBlock BigInt  @map("last_processed_block")
  lastProcessedHash  String? @map("last_processed_hash")
  /// Chain tip as last observed, for lag alerting.
  chainTipBlock      BigInt? @map("chain_tip_block")

  /// Set while a worker holds the lease; lets a stalled worker be taken over.
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)

  lastReorgAt    DateTime? @map("last_reorg_at") @db.Timestamptz(6)
  lastReorgDepth Int?      @map("last_reorg_depth")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("chain_cursors")
}

// ============================================================================
// DOUBLE-ENTRY LEDGER (SPEC section 20)
// ============================================================================

model LedgerAccount {
  id String @id

  /// Stable machine name, e.g. "merchant_payable:mch_01H...:USDT:ETHEREUM".
  code String            @unique
  name String
  type LedgerAccountType

  merchantId String?   @map("merchant_id")
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  /// Every account holds exactly one asset; cross-asset postings are impossible.
  assetSymbol   String  @map("asset_symbol")
  assetDecimals Int     @map("asset_decimals")
  network       Network?

  /// Cached running balance. The ledger_entries table remains the source of
  /// truth; reconciliation recomputes from entries and flags any drift.
  cachedBalance     Decimal   @default(0) @map("cached_balance") @db.Decimal(78, 0)
  cachedBalanceAt   DateTime? @map("cached_balance_at") @db.Timestamptz(6)
  /// Sequence of the last entry folded into cachedBalance.
  cachedThroughSeq  BigInt?   @map("cached_through_seq")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries LedgerEntry[]

  @@index([merchantId, assetSymbol])
  @@index([type])
  @@map("ledger_accounts")
}

/// A balanced group of entries. Debits and credits within one transaction must
/// sum to zero per asset; enforced by a deferred constraint trigger.
model LedgerTransaction {
  id String @id

  /// e.g. "payment.credit", "settlement.payout", "refund.debit", "fee.charge".
  type        String
  description String?

  /// Business reference this posting arises from.
  invoiceId String?  @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  tokenTransferId String?        @map("token_transfer_id")
  tokenTransfer   TokenTransfer? @relation(fields: [tokenTransferId], references: [id], onDelete: Restrict)

  settlementId String?     @map("settlement_id")
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  refundId String? @map("refund_id")
  refund   Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict)

  /// Guards against double-posting the same business event. Every writer must
  /// supply one, e.g. "credit:ETHEREUM:0xabc...:0".
  idempotencyKey String @unique @map("idempotency_key")

  /// Set when this transaction reverses an earlier one. History is never
  /// deleted or edited; a correction is always a new, linked posting.
  reversesId String? @unique @map("reverses_id")

  postedAt  DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entries LedgerEntry[]

  @@index([invoiceId])
  @@index([type, postedAt])
  @@map("ledger_transactions")
}

/// APPEND-ONLY. Updates and deletes are rejected by a database trigger.
model LedgerEntry {
  id String @id

  /// Global monotonic ordering, used for cache invalidation and audit replay.
  sequence BigInt @unique @default(autoincrement())

  ledgerTransactionId String            @map("ledger_transaction_id")
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  accountId String        @map("account_id")
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  direction LedgerDirection
  /// Always positive; the direction column carries the sign.
  amount    Decimal         @db.Decimal(78, 0)

  assetSymbol   String @map("asset_symbol")
  assetDecimals Int    @map("asset_decimals")

  /// Free-form provenance, e.g. {"tx_hash": "0x...", "network": "ETHEREUM"}.
  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, sequence])
  @@index([ledgerTransactionId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ============================================================================
// SETTLEMENT & REFUNDS (SPEC sections 13, 29)
// ============================================================================

model Settlement {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  destinationId String?            @map("destination_id")
  destination   PayoutDestination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  network       Network
  assetSymbol   String  @map("asset_symbol")
  assetDecimals Int     @map("asset_decimals")

  /// Gross amount owed, in smallest units.
  grossAmount Decimal @map("gross_amount") @db.Decimal(78, 0)
  /// Gateway fee withheld.
  feeAmount   Decimal @default(0) @map("fee_amount") @db.Decimal(78, 0)
  /// Estimated or actual network fee.
  networkFee  Decimal @default(0) @map("network_fee") @db.Decimal(78, 0)
  /// grossAmount - feeAmount - networkFee.
  netAmount   Decimal @map("net_amount") @db.Decimal(78, 0)

  status SettlementStatus @default(SCHEDULED)

  /// Signing-service request id; the gateway never holds the key itself.
  signingRequestId String? @map("signing_request_id")
  txHash           String? @map("tx_hash")

  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)

  periodStart DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime? @map("period_end") @db.Timestamptz(6)

  failureReason String?   @map("failure_reason")
  broadcastAt   DateTime? @map("broadcast_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerTransactions LedgerTransaction[]

  @@index([merchantId, status])
  @@index([status, createdAt])
  @@map("settlements")
}

model Refund {
  id String @id

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  network       Network
  assetSymbol   String  @map("asset_symbol")
  assetDecimals Int     @map("asset_decimals")
  amount        Decimal @db.Decimal(78, 0)

  /// Destination must be validated against the originating transaction's
  /// sender; arbitrary caller-supplied addresses are rejected (SPEC section 29).
  destinationAddress           String  @map("destination_address")
  destinationAddressNormalized String  @map("destination_address_normalized")
  /// True when the destination equals the address that funded the invoice.
  destinationDerivedFromPayer  Boolean @default(false) @map("destination_derived_from_payer")

  reason String?
  status RefundStatus @default(REQUESTED)

  complianceStatus ComplianceStatus @default(PENDING) @map("compliance_status")

  requestedBy String    @map("requested_by")
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedBy  String?   @map("rejected_by")
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)

  signingRequestId String? @map("signing_request_id")
  txHash           String? @map("tx_hash")

  failureReason String?   @map("failure_reason")
  broadcastAt   DateTime? @map("broadcast_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerTransactions LedgerTransaction[]

  @@index([merchantId, status])
  @@index([invoiceId])
  @@map("refunds")
}

// ============================================================================
// SIGNING (Phase 12, C2 - see docs/decisions/0026-kms-hsm-signing.md)
//
// Durable state for @gateway/signing's PolicyEnforcingSigningService -
// destination allowlist, amount ceilings and multi-approval decisions are
// enforced in that package; this table only persists the outcome across a
// restart, which an in-memory ApprovalStore cannot. Mode A (custodial
// signing) is not live: nothing in this schema, on its own, can move funds.
// No private key material is ever stored here or anywhere else in this
// database - see packages/signing's HsmKeyStore for where keys actually
// live (a KMS/HSM, real or emulated).
// ============================================================================

enum SigningRequestStatus {
  PENDING_APPROVAL
  SIGNED
  REJECTED
}

model SigningApprovalRequest {
  id String @id

  merchantId  String @map("merchant_id")
  network     String
  asset       String
  fromAddress String @map("from_address")
  toAddress   String @map("to_address")
  /// Smallest unit - see packages/database's money-mapper for the bigint boundary.
  amount      Decimal @db.Decimal(78, 0)

  requestedBy String   @map("requested_by")
  requestedAt DateTime @map("requested_at") @db.Timestamptz(6)

  status SigningRequestStatus @default(PENDING_APPROVAL)

  /// Deduplicated approver user ids, in the order they approved - a JSON
  /// string array, not a join table: the count rarely exceeds a handful and
  /// nothing queries by individual approver.
  approvals Json @default("[]")

  rejectedBy      String? @map("rejected_by")
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([merchantId, network, status])
  @@index([status])
  @@map("signing_approval_requests")
}

/// Append-only, one row per successfully signed request - `SpendTracker`'s
/// durable backing (`PrismaSpendTracker`, apps/api). Deliberately its own
/// table, not a query over `signing_approval_requests.status = 'SIGNED'`:
/// `PolicyEnforcingSigningService.finalizeAndSign` calls `SpendTracker.record()`
/// and `ApprovalStore.save()` as two separate awaited steps, so a
/// concurrent rolling-window check could observe the gap between them if
/// this table derived its total from the other one's current status
/// instead of its own independently-written rows.
model SigningSpendEntry {
  id String @id

  merchantId String   @map("merchant_id")
  network    String
  amount     Decimal  @db.Decimal(78, 0)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([merchantId, network, occurredAt])
  @@map("signing_spend_entries")
}

// ============================================================================
// WEBHOOKS (SPEC sections 17, 18)
// ============================================================================

/// The event itself, generated once. Deliveries fan out from here, so a
/// redelivery always carries the identical payload and event id.
model WebhookEvent {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  invoiceId String?  @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// e.g. "payment.paid".
  type String
  /// The exact JSON body that is signed and sent. Frozen once written.
  payload Json

  /// Prevents emitting the same logical event twice, e.g.
  /// "payment.paid:inv_01H...".
  idempotencyKey String @unique @map("idempotency_key")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveries WebhookDelivery[]

  @@index([merchantId, type, occurredAt])
  @@index([invoiceId])
  @@map("webhook_events")
}

model WebhookDelivery {
  id String @id

  webhookEventId String       @map("webhook_event_id")
  webhookEvent   WebhookEvent @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)

  endpointId String          @map("endpoint_id")
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  url     String
  attempt Int
  status  WebhookDeliveryStatus @default(PENDING)

  httpStatus       Int?    @map("http_status")
  responseTimeMs   Int?    @map("response_time_ms")
  /// Truncated response body, for debugging. Never contains our secrets.
  responseBody     String? @map("response_body")
  errorMessage     String? @map("error_message")

  /// Timestamp included in the signed payload; also the replay window anchor.
  signatureTimestamp DateTime @map("signature_timestamp") @db.Timestamptz(6)

  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// One row per attempt; retrying is an insert, never an overwrite.
  @@unique([webhookEventId, endpointId, attempt])
  @@index([status, nextRetryAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// ============================================================================
// IDEMPOTENCY, COMPLIANCE, RECONCILIATION, AUDIT
// ============================================================================

/// SPEC section 14: every mutating API call carries an idempotency key. The
/// stored response is replayed verbatim for a repeat of the same request.
model IdempotencyKey {
  id String @id

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  key      String
  endpoint String
  /// SHA-256 of the canonical request body. A key reused with a DIFFERENT body
  /// is a client bug and is rejected rather than silently served.
  requestHash String @map("request_hash")

  /// Held while the first request is still running, so concurrent retries wait
  /// instead of double-executing.
  lockedAt          DateTime? @map("locked_at") @db.Timestamptz(6)
  responseStatus    Int?      @map("response_status")
  responseBody      Json?     @map("response_body")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([merchantId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Extension point for KYC/AML/sanctions providers (SPEC section 24). The
/// gateway records the decision and its provenance; the actual screening is
/// performed by a pluggable provider.
model ComplianceCheck {
  id String @id

  /// "invoice", "transfer", "refund", "merchant".
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  invoiceId String?  @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  tokenTransferId String?        @map("token_transfer_id")
  tokenTransfer   TokenTransfer? @relation(fields: [tokenTransferId], references: [id], onDelete: SetNull)

  /// "sanctions", "aml_risk", "travel_rule", "geo_restriction".
  checkType String           @map("check_type")
  provider  String
  status    ComplianceStatus

  riskScore Int?    @map("risk_score")
  /// Provider response, retained for the regulatory record.
  findings  Json    @default("{}")

  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  notes      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId])
  @@index([status, createdAt])
  @@map("compliance_checks")
}

/// SPEC section 21: one row per reconciliation pass.
model ReconciliationRun {
  id String @id

  network Network?
  /// "chain_vs_db", "db_vs_ledger", "ledger_balance", "settlement".
  scope   String
  status  ReconciliationStatus @default(RUNNING)

  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)

  checkedCount     Int @default(0) @map("checked_count")
  discrepancyCount Int @default(0) @map("discrepancy_count")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  errorMessage String?  @map("error_message")

  discrepancies ReconciliationDiscrepancy[]

  @@index([status, startedAt])
  @@map("reconciliation_runs")
}

/// A mismatch. SPEC section 21: never silently corrected - it stays open until
/// a human resolves it, and the resolution itself is recorded.
model ReconciliationDiscrepancy {
  id String @id

  runId String            @map("run_id")
  run   ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  kind     DiscrepancyKind
  severity DiscrepancySeverity @default(WARNING)

  subjectType String  @map("subject_type")
  subjectId   String  @map("subject_id")
  network     Network?

  expectedValue String? @map("expected_value")
  actualValue   String? @map("actual_value")
  details       Json    @default("{}")

  resolvedBy    String?   @map("resolved_by")
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote String?  @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([runId])
  @@index([kind, resolvedAt])
  @@index([severity, resolvedAt])
  @@map("reconciliation_discrepancies")
}

/// APPEND-ONLY. Every privileged action lands here (SPEC section 22).
model AuditLog {
  id String @id

  /// "user", "api_key", "system", "worker".
  actorType String  @map("actor_type")
  actorId   String? @map("actor_id")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  merchantId String? @map("merchant_id")

  /// e.g. "api_key.created", "refund.approved", "merchant.suspended".
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  /// Redacted before write: never contains secrets, keys or tokens.
  before Json?
  after  Json?
  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([merchantId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
